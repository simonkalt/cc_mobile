# =============================================================================
# Server secrets template — safe to commit (placeholders only).
#
# Local workflow:
#   cp .secrets.example .secrets   # then fill in `.secrets` only (gitignored)
#
# Render (Docker or native Python):
#   Dashboard → Environment → Secret Files → Add Secret File
#   Filename: .secrets   (must match — mounted at /etc/secrets/.secrets)
#   Contents: paste this file with real values (KEY=value, same as local `.secrets`)
#
# Load order: `.env` first, then secrets (app/core/env_loader.py).
# Optional override: SECRETS_FILE=/absolute/path/to/secrets
#
# Generate random keys:  openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# Auth & session signing (production: required; never use defaults)
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_SECRET_KEY=

# Server-to-server integrations (see documentation/THIRD_PARTY_SERVICE_AUTH.md)
SERVICE_AUTH_KEY=

# -----------------------------------------------------------------------------
# OAuth login — server-side only (see documentation/OAUTH_LOGIN_API.md)
# -----------------------------------------------------------------------------
# Google: use the **Web application** OAuth client (same ID as
# EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID in the mobile app). iOS/Android
# client IDs do not have a server secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn: prefer these server names over EXPO_PUBLIC_* in .env
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Database & cache
# -----------------------------------------------------------------------------
MONGODB_URI=

# Redis — connection uses REDIS_HOST/PORT/SSL from `.env`; auth uses:
# Redis Cloud: set both (username is almost always `default` in the ACL console)
REDIS_PASSWORD=
REDIS_USERNAME=default
# (REDIS_API_KEY exists in config but is not used by redis_utils.py today)

# -----------------------------------------------------------------------------
# LLM & AI providers
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
HF_TOKEN=

# -----------------------------------------------------------------------------
# AWS (resume / cover letter file storage)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Email (Zoho Mail API)
# -----------------------------------------------------------------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# SMS (Telnyx)
# -----------------------------------------------------------------------------
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# Stripe (use test keys locally; live keys only in production `.secrets`)
# -----------------------------------------------------------------------------
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Apple App Store Server API (StoreKit verification)
# Prefer APP_STORE_PRIVATE_KEY_PATH pointing at a PEM outside the repo, or
# paste PEM below (use \n for newlines if your loader supports it).
# -----------------------------------------------------------------------------
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
# APP_STORE_PRIVATE_KEY_PATH=/secure/path/outside/repo/AuthKey_XXXXXX.p8

# -----------------------------------------------------------------------------
# Optional / misc
# -----------------------------------------------------------------------------
NUTRIENT_API_KEY=
GOOGLE_PLACES_API_KEY=

# =============================================================================
# What stays in `.env` (non-secret config) — examples only:
#
#   REDIS_HOST=redis-....cloud.redislabs.com
#   REDIS_PORT=15435
#   REDIS_DB=0
#   REDIS_SSL=false
#   REDIS_USERNAME=default          # optional; can move to .secrets instead
#   MONGODB_DB_NAME=CoverLetter
#   EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=...
#
# Move to `.secrets` when possible:
#   REDIS_PASSWORD, MONGODB_URI, JWT_SECRET, OAuth secrets, API keys, etc.
# =============================================================================
